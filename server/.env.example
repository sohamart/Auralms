PORT=5000
NODE_ENV=development
# MongoDB URI - Defaults to automatic embedded/memory DB if local 27017 is unreachable
# Example for local: mongodb://127.0.0.1:27017/auralms
# Example for Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/auralms
MONGODB_URI=mongodb://127.0.0.1:27017/auralms

JWT_SECRET=super_secret_jwt_key_auralms_production_grade_32bytes_min
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@auralms.com
ADMIN_PASSWORD=AdminPass123!
